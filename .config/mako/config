# Mako notifications, desktop PC: Rosé Pine Moon, matching the waybar "Corners" tabs.
# Reference: `man 5 mako`. Apply edits with `makoctl reload`; test with `notify-send -u critical hi there`.
# Dismiss: SUPER+BackSpace (newest), SUPER+SHIFT+BackSpace (all), SUPER+CTRL+BackSpace (restore).

font=JetBrainsMono Nerd Font 11
width=380
height=200
padding=12,16
margin=8
outer-margin=40,5,0,0
anchor=top-right
layer=overlay
max-visible=5
sort=-time
group-by=app-name

background-color=#232136f2
text-color=#e0def4
border-color=#c4a7e7
border-size=2
border-radius=18
progress-color=over #393552

icons=1
max-icon-size=48
icon-location=left

markup=1
format=<b>%s</b>\n%b
default-timeout=6000
ignore-timeout=0

[grouped]
format=<b>%s</b> <span color="#908caa">(%g)</span>\n%b

[urgency=low]
border-color=#393552
text-color=#908caa
default-timeout=4000

[urgency=high]
border-color=#eb6f92
default-timeout=0

[mode=do-not-disturb]
invisible=1
